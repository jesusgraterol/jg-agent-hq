---
import { getEntry } from 'astro:content';
import { Exception } from 'error-message-utils';

import DocsPage from '../../components/docs-page/docs-page.astro';
import BaseLayout from '../../layouts/base-layout/base-layout.astro';
import { PAGE_RECORDS } from '../../site.config.ts';

const document = await getEntry('documents', 'getting-started');
if (!document) throw new Exception('The HQ website source is invalid');
---

<BaseLayout page={PAGE_RECORDS[1]}
  ><DocsPage
    document={document}
    page={PAGE_RECORDS[1]}
  /></BaseLayout
>
