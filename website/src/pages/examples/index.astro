---
import { getEntry } from 'astro:content';
import PageHeader from 'jg-personal-astro-ui/page-header';
import Container from 'jg-personal-astro-ui/container';
import TextLink from 'jg-personal-astro-ui/text-link';
import { ArrowRight } from '@lucide/astro';

import ExampleWalkthrough from '../../components/example-walkthrough/example-walkthrough.astro';
import { createExamples, EXAMPLES_PAGE_LEDE } from '../../content/index.ts';
import BaseLayout from '../../layouts/base-layout/base-layout.astro';
import { PAGE_RECORDS } from '../../site.config.ts';

const examples = createExamples({
  'control-session': (await getEntry('examples', 'control-session'))?.body,
});
---

<BaseLayout page={PAGE_RECORDS.find((page) => page.id === 'examples')!}>
  <PageHeader
    eyebrow="Examples"
    title="Worked examples"
    lede={EXAMPLES_PAGE_LEDE}
  />
  <Container>
    <nav
      aria-label="Worked examples"
      class="flex flex-wrap gap-x-7 gap-y-4 border-b border-border py-6 text-sm"
    >
      {
        examples.map((example) => (
          <TextLink href={`#${example.id}`}>
            {example.number} / {example.category}
          </TextLink>
        ))
      }
    </nav>
  </Container>
  {examples.map((example) => <ExampleWalkthrough example={example} />)}
  <Container class="py-12 sm:py-16">
    <p class="text-sm">
      <TextLink href="/docs/api/"
        >Every command in the API reference <ArrowRight
          class="ml-1 inline size-3.5"
          aria-hidden="true"
        /></TextLink
      >
    </p>
  </Container>
</BaseLayout>
