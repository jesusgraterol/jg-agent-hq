---
import Badge from 'jg-personal-astro-ui/badge';
import Conversation from 'jg-personal-astro-ui/conversation';
import ConversationMessage from 'jg-personal-astro-ui/conversation-message';
import InlineCode from 'jg-personal-astro-ui/inline-code';
import { ArrowRight, UserRound } from '@lucide/astro';

import { HOME_CONTENT } from '../../content/index.ts';

import PreviewFrame from '../preview-frame/preview-frame.astro';
import ProviderMark from '../provider-mark/provider-mark.astro';

const example = HOME_CONTENT.collaborationExample;
---

<PreviewFrame caption={example.caption}>
  <p class="mb-5 text-sm leading-6 text-muted">{example.setup}</p>
  <Conversation label={example.label}>
    {
      example.messages.map((message) => (
        <ConversationMessage speaker={message.speaker}>
          <span
            slot="avatar"
            class:list={[
              'inline-flex size-8 items-center justify-center rounded-xl',
              message.provider === null
                ? 'bg-primary text-primary-foreground'
                : 'border border-border bg-secondary',
            ]}
          >
            {message.provider === null ? (
              <UserRound class="size-4" />
            ) : (
              <ProviderMark provider={message.provider} />
            )}
          </span>
          <p class="flex flex-wrap items-center gap-2 text-xs text-muted">
            <Badge
              variant={
                message.kind === 'task' || message.kind === 'request' ? 'secondary' : 'success'
              }
            >
              {message.kind}
            </Badge>
            <ArrowRight
              class="size-4 shrink-0"
              aria-hidden="true"
            />
            <span class="sr-only">to</span>
            <Badge
              variant="outline"
              mono={false}
            >
              <span
                class="inline-flex size-3 shrink-0 items-center justify-center"
                aria-hidden="true"
              >
                {message.recipientProvider === null ? (
                  <UserRound class="size-3" />
                ) : (
                  <ProviderMark
                    provider={message.recipientProvider}
                    size="compact"
                  />
                )}
              </span>
              {message.recipient}
            </Badge>
          </p>
          <p class="mt-2 text-sm leading-6">{message.text}</p>
          <p
            slot="footer"
            class="text-xs leading-5 text-muted"
          >
            {message.command && (
              <span class="mb-1 block">
                <InlineCode code={message.command} />
              </span>
            )}
            {message.note}
          </p>
        </ConversationMessage>
      ))
    }
  </Conversation>
</PreviewFrame>
