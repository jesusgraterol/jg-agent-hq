---
import Badge from 'jg-personal-astro-ui/badge';
import InlineCode from 'jg-personal-astro-ui/inline-code';

import PreviewFrame from '../preview-frame/preview-frame.astro';

// the decisions a Codex command approval accepts through native-reply
const DECISIONS = ['accept', 'acceptForSession', 'decline', 'cancel'] as const;
---

<PreviewFrame caption="Illustrative · a Codex permission prompt">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <Badge
      variant="warning"
      dot
      >Waiting for you</Badge
    >
    <span class="font-mono text-xs text-muted">build-reports · Codex</span>
  </div>
  <p class="mt-4 font-semibold">Run a command</p>
  <pre
    class="mt-3 rounded-lg bg-terminal p-3 font-mono text-sm whitespace-pre-wrap text-terminal-foreground"><code>pnpm test --filter reports</code></pre>
  <p class="mt-5 font-mono text-xs text-muted">Your app replies with one decision</p>
  <ul
    class="mt-2 flex flex-wrap gap-2 text-sm"
    aria-label="Reply decisions"
  >
    {
      DECISIONS.map((decision) => (
        <li>
          <InlineCode code={decision} />
        </li>
      ))
    }
  </ul>
  <p
    class="mt-5 flex flex-wrap gap-x-4 gap-y-1 border-t border-border pt-4 font-mono text-xs text-muted"
  >
    <span>Inbox</span><span class="text-foreground">1 pending</span><span>3 answered</span><span
      >1 expired</span
    >
  </p>
</PreviewFrame>
