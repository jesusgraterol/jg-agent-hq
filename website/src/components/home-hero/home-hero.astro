---
import Button from 'jg-personal-astro-ui/button';
import HeroBackdrop from 'jg-personal-astro-ui/hero-backdrop';
import { ArrowDown } from '@lucide/astro';

import { HOME_CONTENT } from '../../content/index.ts';
import ArchitectureMap from '../architecture-map/architecture-map.astro';
---

{/* the shared jg hero: backdrop, eyebrow, two-part display title, lede and two actions */}
<section
  class="relative isolate overflow-hidden border-b border-border"
  aria-labelledby="home-title"
>
  <HeroBackdrop />
  <div
    class="jg-container grid items-center gap-12 pt-14 pb-16 sm:pt-20 sm:pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14"
  >
    <div class="min-w-0">
      <p class="eyebrow">{HOME_CONTENT.eyebrow}</p>
      <h1
        id="home-title"
        class="display-title mt-6"
      >
        {HOME_CONTENT.headline[0]}{' '}<span class="block text-accent"
          >{HOME_CONTENT.headline[1]}</span
        >
      </h1>
      <p class="lede mt-7">{HOME_CONTENT.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="#capabilities"
          >See what it does <ArrowDown
            class="size-4"
            aria-hidden="true"
          /></Button
        ><Button
          href="#start"
          variant="outline"
          >Set up locally</Button
        >
      </div>
    </div>
    <ArchitectureMap />
  </div>
</section>
