---
import Section from 'jg-personal-astro-ui/section';
import InstallCommand from 'jg-personal-astro-ui/install-command';
import CodeBlock from 'jg-personal-astro-ui/code-block';
import TextLink from 'jg-personal-astro-ui/text-link';
import Step from 'jg-personal-astro-ui/step';
import Steps from 'jg-personal-astro-ui/steps';
import { ArrowRight, Layers, Monitor, Terminal } from '@lucide/astro';

import { HOME_CONTENT, CONTROL_EXAMPLE } from '../../content/index.ts';

const icons = [Monitor, Layers, Terminal];
---

<Section
  id="start"
  eyebrow="Start on your machine"
  title={HOME_CONTENT.startTitle}
  lede={HOME_CONTENT.startDescription}
  border
>
  <div class="mt-9 grid min-w-0 gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-16">
    <div>
      <p class="font-mono text-xs leading-6 text-muted">{HOME_CONTENT.requirements}</p>
      <p class="mt-5 max-w-md text-sm leading-7 text-muted">
        Install and sign in through Claude Code or Codex first. Keep the controller running while
        your application connects.
      </p>
      <p class="mt-6 text-sm">
        <TextLink href="/docs/"
          >Read the docs <ArrowRight
            class="ml-1 inline size-3.5"
            aria-hidden="true"
          /></TextLink
        >
      </p>
    </div>
    <Steps label="Local setup">
      {
        HOME_CONTENT.setup.map((step, index) => (
          <Step
            title={step.title}
            number={`0${index + 1}`}
          >
            <h3
              slot="title"
              class="font-semibold"
            >
              {step.title}
            </h3>
            <InstallCommand
              command={step.command}
              id={index === 0 ? 'install-command' : `setup-command-${index}`}
              context={
                index === 0 ? 'install command' : index === 1 ? 'start command' : 'status command'
              }
              title={step.title}
            />
            <p class="mt-2 text-xs leading-6 text-muted">{step.text}</p>
          </Step>
        ))
      }
    </Steps>
  </div>
</Section>
<Section
  id="integration"
  eyebrow="How it fits"
  title={HOME_CONTENT.integrationTitle}
  lede={HOME_CONTENT.integrationDescription}
>
  <ol class="mt-10 grid min-w-0 gap-6 md:grid-cols-3">
    {
      HOME_CONTENT.integration.map((item, index) => {
        const Icon = icons[index]!;
        return (
          <li class="min-w-0 border-t border-border pt-6">
            <Icon
              class="size-6 text-accent"
              aria-hidden="true"
            />
            <h3 class="mt-4 text-xl font-semibold">{item.title}</h3>
            <p class="mt-2 font-mono text-xs leading-6 text-accent">{item.label}</p>
            <p class="mt-3 text-sm leading-7 text-muted">{item.text}</p>
          </li>
        );
      })
    }
  </ol>
</Section>
<Section
  id="session-code"
  eyebrow="A concrete first step"
  title="A session, from code to result"
  lede={CONTROL_EXAMPLE.goal}
  border
>
  <div class="mt-8 grid min-w-0 gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-12">
    <CodeBlock
      code={CONTROL_EXAMPLE.call}
      lang="ts"
      title="Call the session helper"
    />
    <div class="min-w-0 lg:pt-3">
      <p class="eyebrow">Expected delivery output</p>
      <p class="mt-4 font-mono text-2xl font-semibold text-success">{CONTROL_EXAMPLE.result}</p>
      <p class="mt-4 text-sm leading-7 text-muted">{CONTROL_EXAMPLE.resultNote}</p>
      <p class="mt-6 text-sm">
        <TextLink href="/examples/#control-session"
          >Get the complete helper and walkthrough <ArrowRight
            class="ml-1 inline size-3.5"
            aria-hidden="true"
          /></TextLink
        >
      </p>
    </div>
  </div>
</Section>
