---
import Section from 'jg-personal-astro-ui/section';
import TextLink from 'jg-personal-astro-ui/text-link';

import { HOME_CONTENT } from '../../site.config.ts';
---

<Section
  id="workflow"
  eyebrow="A deliberate workflow"
  title="Move work forward, with intent."
  layout="split"
  border
>
  <ol class="mt-8 grid gap-8 sm:grid-cols-3">
    {
      HOME_CONTENT.workflow.map((item) => (
        <li class="min-w-0">
          <>
            <p class="mb-4 font-mono text-sm text-accent">{item.label}</p>
            <h3 class="text-lg font-semibold">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-muted">{item.text}</p>
          </>
        </li>
      ))
    }
  </ol>
  <div class="mt-10 grid gap-6 border-t border-border pt-8 sm:grid-cols-2">
    <p class="text-sm leading-7 text-muted">
      Account usage comes from native observations, with explicit stale and unavailable states.
      Immediate steering is provider-dependent; Claude currently supports queued input rather than
      immediate steering.
    </p>
    <p class="text-sm leading-7 text-muted">
      This is a standalone TypeScript package and CLI. Applications supply their own UI,
      authentication and deployment. <TextLink href="/docs/api/"
        >Explore the integration boundary</TextLink
      >
    </p>
  </div>
</Section>
