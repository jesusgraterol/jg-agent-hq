---
import CodeBlock from 'jg-personal-astro-ui/code-block';
import Section from 'jg-personal-astro-ui/section';
import TextLink from 'jg-personal-astro-ui/text-link';

import { HOME_CONTENT, USAGE_EXAMPLE } from '../../site.config.ts';
---

<Section
  id="workflow"
  eyebrow="Start small"
  title="A local runtime. An API you can build on."
  lede="Start the controller, read a real account observation, then connect the workflows your application needs."
  border
>
  <div class="mt-8 grid min-w-0 gap-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-14">
    <ol class="space-y-7">
      {
        HOME_CONTENT.workflow.map((item) => (
          <li class="flex min-w-0 gap-4">
            <span class="pt-1 font-mono text-xs text-accent">{item.label}</span>
            <div class="min-w-0">
              <>
                <h3 class="font-semibold">{item.title}</h3>
                <p class="mt-2 text-sm leading-7 text-muted">{item.text}</p>
              </>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="min-w-0">
      <CodeBlock
        code={USAGE_EXAMPLE}
        lang="ts"
        title="Read native account usage"
      /><p class="mt-3 text-xs leading-6 text-muted">
        Usage is an observation, not an estimate. Check its state before displaying a percentage.
      </p>
    </div>
  </div>
  <div class="mt-10 grid gap-6 border-t border-border pt-8 sm:grid-cols-2">
    <p class="text-sm leading-7 text-muted">{HOME_CONTENT.nativeBehavior}</p>
    <p class="text-sm leading-7 text-muted">
      {HOME_CONTENT.integration}
      <TextLink href="/docs/api/">Explore the integration boundary</TextLink>
    </p>
  </div>
</Section>
