---
import InlineCode from 'jg-personal-astro-ui/inline-code';
import Section from 'jg-personal-astro-ui/section';
import TextLink from 'jg-personal-astro-ui/text-link';
import { ArrowRight } from '@lucide/astro';

import { HOME_CONTENT } from '../../content/index.ts';
import PlanPreview from '../plan-preview/plan-preview.astro';
import PromptPreview from '../prompt-preview/prompt-preview.astro';
import SessionPreview from '../session-preview/session-preview.astro';
import StoragePreview from '../storage-preview/storage-preview.astro';
import StreamPreview from '../stream-preview/stream-preview.astro';
import UsagePreview from '../usage-preview/usage-preview.astro';

// the preview that shows each capability, by its id
const PREVIEWS = {
  sessions: SessionPreview,
  prompts: PromptPreview,
  observe: UsagePreview,
  collaboration: StreamPreview,
  plans: PlanPreview,
  storage: StoragePreview,
} as const satisfies Record<(typeof HOME_CONTENT.capabilities)[number]['id'], unknown>;
---

<Section
  id="capabilities"
  eyebrow="What it does"
  title={HOME_CONTENT.capabilitiesTitle}
>
  <div class="mt-12 grid min-w-0 gap-16 sm:mt-16 lg:gap-24">
    {
      HOME_CONTENT.capabilities.map((capability, index) => {
        const Preview = PREVIEWS[capability.id];
        const isReversed = index % 2 === 1;
        return (
          <article
            id={`capability-${capability.id}`}
            class:list={[
              'grid min-w-0 scroll-mt-20 items-center gap-8 lg:gap-14',
              isReversed
                ? 'lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]'
                : 'lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]',
            ]}
            aria-labelledby={`capability-${capability.id}-title`}
          >
            <div class:list={['min-w-0', { 'lg:order-last': isReversed }]}>
              <p class="font-mono text-xs font-semibold text-accent">0{index + 1}</p>
              <h3
                id={`capability-${capability.id}-title`}
                class="mt-3 text-2xl leading-tight font-semibold tracking-tight sm:text-3xl"
              >
                {capability.title}
              </h3>
              <p class="mt-4 max-w-md leading-7 text-muted">{capability.text}</p>
              <ul
                class="mt-6 flex flex-wrap gap-2 text-sm"
                aria-label={`${capability.title}: commands`}
              >
                {capability.commands.map((command) => (
                  <li>
                    <InlineCode code={command} />
                  </li>
                ))}
              </ul>
              {capability.link && (
                <p class="mt-6 text-sm">
                  <TextLink href={capability.link.href}>
                    {capability.link.label}{' '}
                    <ArrowRight
                      class="ml-1 inline size-3.5"
                      aria-hidden="true"
                    />
                  </TextLink>
                </p>
              )}
            </div>
            <Preview />
          </article>
        );
      })
    }
  </div>
</Section>
