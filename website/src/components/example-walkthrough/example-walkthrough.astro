---
import Container from 'jg-personal-astro-ui/container';
import Tabs from 'jg-personal-astro-ui/tabs';
import CodeBlock from 'jg-personal-astro-ui/code-block';
import InlineCode from 'jg-personal-astro-ui/inline-code';
import InstallCommand from 'jg-personal-astro-ui/install-command';
import { Check, CornerDownRight } from '@lucide/astro';

import type { IWorkedExample } from '../../content/index.ts';

interface Props {
  example: IWorkedExample;
}
const { example } = Astro.props;
const tabs = [
  { id: 'result', label: 'Result' },
  { id: 'integration', label: 'Run it' },
  { id: 'source', label: 'Source' },
];
---

<article
  id={example.id}
  class="scroll-mt-24 border-b border-border py-12 sm:py-20"
  aria-labelledby={`${example.id}-title`}
>
  <Container>
    <header class="max-w-3xl">
      <p class="eyebrow">{example.number} / {example.category}</p>
      <h2
        id={`${example.id}-title`}
        class="mt-4 text-3xl leading-tight font-semibold tracking-tight sm:text-4xl"
      >
        {example.title}
      </h2>
      <p class="mt-4 text-lg leading-8 text-muted">{example.goal}</p>
    </header>
    <ol
      class="mt-10 grid min-w-0 gap-3 md:grid-cols-3"
      aria-label={`${example.category} steps`}
    >
      {
        example.steps.map((step, index) => (
          <li class="flex min-w-0 flex-col rounded-xl border border-border bg-surface p-5 shadow-surface">
            <div class="flex min-w-0 items-center gap-3">
              <span
                class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent font-mono text-xs font-semibold text-accent-foreground"
                aria-hidden="true"
              >
                0{index + 1}
              </span>
              <h3 class="min-w-0 font-semibold">{step.title}</h3>
            </div>
            <p class="mt-4 flex min-w-0 flex-wrap gap-1.5 text-sm">
              {step.commands.map((command) => (
                <InlineCode code={command} />
              ))}
            </p>
            <p class="mt-auto flex gap-2 pt-4 text-sm leading-6 text-muted">
              <CornerDownRight
                class="mt-1 size-4 shrink-0"
                aria-hidden="true"
              />
              {step.outcome}
            </p>
          </li>
        ))
      }
    </ol>
    <div class="mt-10 grid min-w-0 gap-10 lg:grid-cols-[minmax(0,0.6fr)_minmax(0,1.4fr)] lg:gap-14">
      <div class="min-w-0">
        <h3 class="text-lg font-semibold">You need</h3>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-muted">
          {
            example.prerequisites.map((item) => (
              <li class="flex gap-3">
                <Check
                  class="mt-1 size-4 shrink-0 text-accent"
                  aria-hidden="true"
                />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="min-w-0">
        <Tabs
          id={`${example.id}-example`}
          label={`${example.category} walkthrough`}
          tabs={tabs}
        >
          <div
            slot="result"
            class="pt-6"
          >
            <h3 class="sr-only">What you get back</h3>
            <div class="border-l-2 border-accent pl-5">
              <p class="font-mono text-xs text-muted">{example.resultLabel}</p>
              <p
                class="mt-2 text-xl leading-8 font-semibold text-success"
                class:list={{ 'font-mono': example.id === 'control-session' }}
              >
                {example.result}
              </p>
              <p class="mt-2 text-sm leading-6 text-muted">{example.resultNote}</p>
            </div>
            <dl class="mt-7 divide-y divide-border">
              {
                example.returns.map((field) => (
                  <div class="grid min-w-0 gap-1 py-3 sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] sm:gap-4">
                    <dt class="min-w-0 font-mono text-sm font-semibold wrap-anywhere">
                      {field.name}
                    </dt>
                    <dd class="text-sm leading-6 text-muted">{field.text}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <div
            slot="integration"
            class="pt-6"
          >
            <h3 class="sr-only">Call the helper</h3>
            <InstallCommand
              copyDisplay="icon"
              id={`${example.id}-install`}
              command={example.install}
              context={`${example.category.toLowerCase()} install command`}
              title="Example dependencies"
            />
            <p class="my-5 text-sm leading-6 text-muted">{example.setup}</p>
            <CodeBlock
              copyDisplay="icon"
              code={example.call}
              lang="ts"
              title="run-session.ts"
            />
          </div>
          <div
            slot="source"
            class="pt-6"
          >
            <h3 class="sr-only">Complete helper</h3>
            <p class="mb-5 text-sm leading-6 text-muted">
              The exact file the integration tests run. Copy it whole.
            </p>
            <div
              class="max-h-[36rem] min-w-0 overflow-y-auto rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus"
              role="region"
              aria-label={`${example.category} complete source`}
              tabindex="0"
            >
              <CodeBlock
                copyDisplay="icon"
                code={example.source}
                lang="ts"
                title={example.sourcePath}
              />
            </div>
          </div>
        </Tabs>
      </div>
    </div>
  </Container>
</article>
