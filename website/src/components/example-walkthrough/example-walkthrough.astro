---
import Container from 'jg-personal-astro-ui/container';
import Tabs from 'jg-personal-astro-ui/tabs';
import CodeBlock from 'jg-personal-astro-ui/code-block';
import InstallCommand from 'jg-personal-astro-ui/install-command';
import TextLink from 'jg-personal-astro-ui/text-link';
import Badge from 'jg-personal-astro-ui/badge';
import { ArrowRight, Check, Circle, Terminal } from '@lucide/astro';

import type { IWorkedExample } from '../../content/index.ts';

interface Props {
  example: IWorkedExample;
}
const { example } = Astro.props;
const tabs = [
  { id: 'result', label: 'Result' },
  { id: 'integration', label: example.call ? 'Run it' : 'Host inputs' },
  { id: 'source', label: 'Source' },
];
---

<article
  id={example.id}
  class="scroll-mt-24 border-b border-border py-12 sm:py-20"
  aria-labelledby={`${example.id}-title`}
>
  <Container>
    <header class="max-w-3xl">
      <p class="eyebrow">{example.number} / {example.category}</p>
      <h2
        id={`${example.id}-title`}
        class="mt-4 text-3xl leading-tight font-semibold tracking-tight sm:text-4xl"
      >
        {example.title}
      </h2>
      <p class="mt-5 text-lg leading-8 text-muted">{example.goal}</p>
    </header>
    <div class="mt-10 grid min-w-0 gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-14">
      <div class="order-last min-w-0 lg:order-first">
        <h3 class="text-lg font-semibold">Before you start</h3>
        <ul class="mt-4 space-y-3 text-sm leading-7 text-muted">
          {
            example.prerequisites.map((item) => (
              <li class="flex gap-3">
                <>
                  <>
                    <Check
                      class="mt-1.5 size-4 shrink-0 text-accent"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </>
                </>
              </li>
            ))
          }
        </ul>
        <ol class="mt-9 space-y-6 border-t border-border pt-7">
          {
            example.steps.map((step, index) => (
              <li class="flex min-w-0 gap-4">
                <>
                  <span class="pt-1 font-mono text-xs text-accent">0{index + 1}</span>
                  <div class="min-w-0">
                    <>
                      <>
                        <h3 class="font-semibold">{step.title}</h3>
                        <p class="mt-2 text-sm leading-7 text-muted">{step.text}</p>
                      </>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="order-first min-w-0 lg:order-last">
        <Tabs
          id={`${example.id}-example`}
          label={`${example.category} walkthrough`}
          tabs={tabs}
        >
          <div
            slot="result"
            class="pt-6"
          >
            <h3 class="sr-only">What you get back</h3>
            {
              example.visual && (
                <figure class="mb-7 rounded-xl border border-border bg-surface p-5 sm:p-6">
                  <figcaption class="font-mono text-xs text-muted">
                    {example.visual.caption}
                  </figcaption>
                  <ol
                    aria-label={`${example.category} result flow`}
                    class:list={[
                      'mt-5 grid min-w-0 gap-4',
                      example.visual.groups.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2',
                    ]}
                  >
                    {example.visual.groups.map((group, index) => (
                      <li class="min-w-0 rounded-lg border border-border bg-background p-4">
                        <>
                          <p class="flex items-center justify-between gap-2 font-mono text-xs text-accent">
                            {group.label}
                            {index < example.visual!.groups.length - 1 && (
                              <ArrowRight
                                class="size-4 shrink-0"
                                aria-hidden="true"
                              />
                            )}
                          </p>
                          <ul class="mt-4 divide-y divide-border">
                            {group.items.map((item) => (
                              <li class="py-3 first:pt-0 last:pb-0">
                                <>
                                  <p class="flex items-center gap-2 font-semibold">
                                    {item.state === 'done' ? (
                                      <Check
                                        class="size-4 shrink-0 text-success"
                                        aria-hidden="true"
                                      />
                                    ) : item.state === 'pending' ? (
                                      <Circle
                                        class="size-4 shrink-0 text-muted"
                                        aria-hidden="true"
                                      />
                                    ) : null}
                                    {item.title}
                                  </p>
                                  <p class="mt-2 text-xs leading-6 text-muted">{item.detail}</p>
                                </>
                              </li>
                            ))}
                          </ul>
                        </>
                      </li>
                    ))}
                  </ol>
                </figure>
              )
            }
            <div class="border-l-2 border-accent pl-5">
              <p class="flex items-center gap-2 font-mono text-xs text-muted">
                <Terminal
                  class="size-4 shrink-0"
                  aria-hidden="true"
                />{example.resultLabel}
              </p>
              <p
                class="mt-3 text-xl leading-8 font-semibold text-success"
                class:list={{ 'font-mono': example.id === 'control-session' }}
              >
                {example.result}
              </p>
              <p class="mt-3 text-sm leading-7 text-muted">{example.resultNote}</p>
            </div>
            <dl class="mt-7 divide-y divide-border">
              {
                example.returns.map((field) => (
                  <div class="grid min-w-0 gap-1 py-4 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-4">
                    <>
                      <>
                        <dt class="min-w-0 font-mono text-sm font-semibold wrap-anywhere">
                          {field.name}
                        </dt>
                        <dd class="text-sm leading-6 text-muted">{field.text}</dd>
                      </>
                    </>
                  </div>
                ))
              }
            </dl>
          </div>
          <div
            slot="integration"
            class="pt-6"
          >
            <h3 class="sr-only">{example.call ? 'Call the helper' : 'Your host supplies'}</h3>
            <InstallCommand
              id={`${example.id}-install`}
              command={example.install}
              context={`${example.category.toLowerCase()} install command`}
              title="Local example dependencies"
            />
            <p class="my-5 text-sm leading-7 text-muted">{example.setup}</p>
            {
              example.call ? (
                <CodeBlock
                  code={example.call}
                  lang="ts"
                  title="run-session.ts"
                />
              ) : (
                <dl class="divide-y divide-border">
                  {example.hostFields.map((field) => (
                    <div class="py-5">
                      <>
                        <dt class="font-mono text-sm font-semibold wrap-anywhere">{field.name}</dt>
                        <dd class="mt-2 text-sm leading-7 text-muted">{field.text}</dd>
                      </>
                    </div>
                  ))}
                </dl>
              )
            }
          </div>
          <div
            slot="source"
            class="pt-6"
          >
            <h3 class="sr-only">Complete helper</h3>
            <p class="mb-5 text-sm leading-7 text-muted">
              The complete source exercised by the public-client integration tests. Copy the whole
              file, then connect its inputs to your host.
            </p>
            <div
              class="max-h-[36rem] min-w-0 overflow-y-auto rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus"
              role="region"
              aria-label={`${example.category} complete source`}
              tabindex="0"
            >
              <CodeBlock
                code={example.source}
                lang="ts"
                title={example.sourcePath}
              />
            </div>
          </div>
        </Tabs>
      </div>
    </div>
    <div
      class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6"
    >
      <Badge variant="outline">Complete TypeScript source</Badge>
      <p class="text-sm">
        <TextLink href="/docs/api/"
          >Explore the API <ArrowRight
            class="ml-1 inline size-3.5"
            aria-hidden="true"
          /></TextLink
        >
      </p>
    </div>
  </Container>
</article>
