---
import Container from 'jg-personal-astro-ui/container';
import Tabs from 'jg-personal-astro-ui/tabs';
import CodeBlock from 'jg-personal-astro-ui/code-block';
import InstallCommand from 'jg-personal-astro-ui/install-command';
import TextLink from 'jg-personal-astro-ui/text-link';
import Badge from 'jg-personal-astro-ui/badge';
import { ArrowDown, ArrowRight, Check, Terminal } from '@lucide/astro';

import type { createControlExample } from '../../content/index.ts';

interface Props {
  example: ReturnType<typeof createControlExample>;
}
const { example } = Astro.props;
---

<article
  id={example.id}
  class="scroll-mt-24 py-12 sm:py-16"
  aria-labelledby={`${example.id}-title`}
>
  <Container>
    <header class="max-w-3xl">
      <p class="eyebrow">{example.number} / Native session control</p>
      <h2
        id={`${example.id}-title`}
        class="mt-4 text-3xl leading-tight font-semibold tracking-tight sm:text-4xl"
      >
        {example.title}
      </h2>
      <p class="mt-5 text-lg leading-8 text-muted">{example.goal}</p>
    </header>
    <div class="mt-10 grid min-w-0 gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-14">
      <div class="order-last min-w-0 lg:order-first">
        <h3 class="text-lg font-semibold">Before you start</h3>
        <ul class="mt-4 space-y-3 text-sm leading-7 text-muted">
          {
            example.prerequisites.map((item) => (
              <li class="flex gap-3">
                <>
                  <Check
                    class="mt-1.5 size-4 shrink-0 text-accent"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </>
              </li>
            ))
          }
        </ul>
        <ol class="mt-9 space-y-6 border-t border-border pt-7">
          {
            example.steps.map((step, index) => (
              <li class="flex min-w-0 gap-4">
                <span class="pt-1 font-mono text-xs text-accent">0{index + 1}</span>
                <div class="min-w-0">
                  <>
                    <h3 class="font-semibold">{step.title}</h3>
                    <p class="mt-2 text-sm leading-7 text-muted">{step.text}</p>
                  </>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="order-first min-w-0 lg:order-last">
        <InstallCommand
          id="example-install-command"
          command={example.install}
          context="example install command"
          title="Local example dependencies"
        />
        <p class="mt-3 text-xs leading-6 text-muted">
          Save the complete helper below as <code class="font-mono text-foreground"
            >control-session.ts</code
          >. Save the caller as <code class="font-mono text-foreground">run-session.ts</code>, then
          run <code class="font-mono text-foreground">node run-session.ts</code> while your controller
          is running.
        </p>
        <Tabs
          class="mt-7"
          id="control-example"
          label="Session walkthrough"
          tabs={[
            { id: 'result', label: 'What you get back' },
            { id: 'call', label: 'Call the helper' },
          ]}
        >
          <div
            slot="call"
            class="pt-5"
          >
            <h3 class="sr-only">Call the helper</h3>
            <CodeBlock
              code={example.call}
              lang="ts"
              title="run-session.ts"
            />
          </div>
          <div
            slot="result"
            class="pt-5"
          >
            <h3 class="text-lg font-semibold">What you get back</h3>
            <div class="mt-5 border-l-2 border-accent pl-5">
              <p class="flex items-center gap-2 font-mono text-xs text-muted">
                <Terminal
                  class="size-4"
                  aria-hidden="true"
                /> Expected delivery output
              </p>
              <p class="mt-3 font-mono text-2xl font-semibold text-success">{example.result}</p>
              <p class="mt-3 text-sm leading-7 text-muted">{example.resultNote}</p>
            </div>
            <dl class="mt-7 divide-y divide-border">
              {
                example.returns.map((field) => (
                  <div class="grid min-w-0 gap-1 py-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-4">
                    <>
                      <dt class="font-mono text-sm font-semibold">{field.name}</dt>
                      <dd class="text-sm leading-6 text-muted">{field.text}</dd>
                    </>
                  </div>
                ))
              }
            </dl>
          </div>
        </Tabs>
      </div>
    </div>
    <details class="group mt-12 border-y border-border py-5">
      <summary
        class="flex min-h-11 cursor-pointer flex-wrap items-center justify-between gap-3 rounded-md py-2 font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus"
      >
        <span class="flex items-center gap-3"
          ><ArrowDown
            class="size-4 text-accent transition-transform group-open:rotate-180 motion-reduce:transition-none"
            aria-hidden="true"
          /> Complete source</span
        >
        <span class="font-mono text-xs font-normal wrap-anywhere text-muted"
          >{example.sourcePath}</span
        >
      </summary>
      <p class="my-4 text-sm leading-7 text-muted">
        This is the same helper exercised by the public-client integration tests. Copy the whole
        file; its native permissions and reconnect decisions remain with your host.
      </p>
      <CodeBlock
        code={example.source}
        lang="ts"
        title={example.sourcePath}
      />
    </details>
    <div class="mt-7 flex flex-wrap items-center justify-between gap-4">
      <Badge variant="outline">Complete TypeScript source</Badge>
      <p class="text-sm">
        <TextLink href="/docs/api/"
          >Explore the API <ArrowRight
            class="ml-1 inline size-3.5"
            aria-hidden="true"
          /></TextLink
        >
      </p>
    </div>
  </Container>
</article>
