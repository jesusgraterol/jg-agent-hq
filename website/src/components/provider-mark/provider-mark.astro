---
interface Props {
  provider: 'claude' | 'codex';
}

const { provider } = Astro.props;
---

{/* decorative provider marks retain their brand colors beside the visible provider name */}
{
  provider === 'claude' ? (
    <img
      src="/coding-agents/claude-code.svg"
      width="20"
      height="20"
      alt=""
      class="size-5 object-contain"
      decoding="async"
    />
  ) : (
    <>
      <img
        src="/coding-agents/codex.svg"
        width="20"
        height="20"
        alt=""
        class="size-5 object-contain dark:hidden"
        decoding="async"
      />
      <img
        src="/coding-agents/codex-dark.svg"
        width="20"
        height="20"
        alt=""
        class="hidden size-5 object-contain dark:block"
        decoding="async"
      />
    </>
  )
}
