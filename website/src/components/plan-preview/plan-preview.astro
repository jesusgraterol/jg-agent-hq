---
import Badge from 'jg-personal-astro-ui/badge';
import { ArrowDown, ArrowRight, Check, Circle } from '@lucide/astro';

import PreviewFrame from '../preview-frame/preview-frame.astro';

// a static revision that adds one requirement; equivalent wording keeps its milestone and evidence
const COLUMNS = [
  {
    label: 'Before',
    milestones: [{ title: 'Greeting', state: 'Verified', note: null }],
  },
  {
    label: 'After',
    milestones: [
      { title: 'Greeting result', state: 'Verified', note: 'same ID, evidence kept' },
      { title: 'Report', state: 'Pending', note: 'new requirement' },
    ],
  },
] as const;
const APPROVALS = ['Plan approved', 'Milestones approved', 'Execution authorized'] as const;
---

<PreviewFrame caption="Illustrative revision · one requirement added">
  <div class="grid min-w-0 gap-3 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-start">
    {
      COLUMNS.map((column, index) => (
        <>
          {index > 0 && (
            <span class="flex justify-center text-muted sm:pt-10">
              <ArrowDown
                class="size-4 sm:hidden"
                aria-hidden="true"
              />
              <ArrowRight
                class="hidden size-4 sm:block"
                aria-hidden="true"
              />
            </span>
          )}
          <div class="min-w-0 rounded-xl border border-border bg-background p-4">
            <p class="font-mono text-xs text-muted">{column.label}</p>
            <ul class="mt-3 grid gap-3">
              {column.milestones.map((milestone) => (
                <li class="min-w-0">
                  <p class="flex items-center gap-2 font-semibold">
                    {milestone.state === 'Verified' ? (
                      <Check
                        class="size-4 shrink-0 text-success"
                        aria-hidden="true"
                      />
                    ) : (
                      <Circle
                        class="size-4 shrink-0 text-muted"
                        aria-hidden="true"
                      />
                    )}
                    <span class="min-w-0">{milestone.title}</span>
                  </p>
                  <p class="mt-1 pl-6 text-xs text-muted">
                    {milestone.state}
                    {milestone.note && ` · ${milestone.note}`}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </>
      ))
    }
  </div>
  <p class="mt-5 font-mono text-xs text-muted">Then fresh approvals, each one explicit</p>
  <ol
    class="mt-2 flex flex-wrap gap-2"
    aria-label="Approvals after the revision"
  >
    {
      APPROVALS.map((approval) => (
        <li>
          <Badge
            variant="success"
            mono={false}
          >
            <Check
              class="size-3.5"
              aria-hidden="true"
            />
            {approval}
          </Badge>
        </li>
      ))
    }
  </ol>
</PreviewFrame>
