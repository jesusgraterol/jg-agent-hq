---
import InlineCode from 'jg-personal-astro-ui/inline-code';
import { ArrowRight, Database, KeyRound } from '@lucide/astro';

import PreviewFrame from '../preview-frame/preview-frame.astro';

// the state root's database and key, which snapshots capture and restores stage together
const TABLES = [
  { prefix: 'hq_*', text: 'Receipts, approvals and session state' },
  { prefix: 'app_*', text: 'Your app’s own tables' },
] as const;
const RECOVERY = [
  { command: 'createHqSnapshot', text: 'Captured while agents work' },
  { command: 'restoreHqSnapshot', text: 'New folder, automation paused' },
] as const;
---

<PreviewFrame caption="Illustrative state root · .runtime">
  <div class="min-w-0 rounded-xl border border-border bg-background p-4">
    <p class="flex items-center gap-2 font-mono text-sm font-semibold">
      <Database
        class="size-4 shrink-0 text-accent"
        aria-hidden="true"
      />hq.sqlite
    </p>
    <ul class="mt-3 grid gap-2">
      {
        TABLES.map((table) => (
          <li class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1 rounded-lg bg-secondary px-3 py-2 text-sm">
            <span class="font-mono font-semibold">{table.prefix}</span>
            <span class="text-muted">{table.text}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-sm font-semibold">
      <KeyRound
        class="size-4 shrink-0 text-accent"
        aria-hidden="true"
      />action.key <span class="font-sans text-xs font-normal text-muted"
        >private, kept with the database</span
      >
    </p>
  </div>
  <ol
    class="mt-3 grid min-w-0 gap-3 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-center"
    aria-label="Snapshot and restore"
  >
    {
      RECOVERY.map((step, index) => (
        <>
          {index > 0 && (
            <li
              class="hidden justify-center text-muted sm:flex"
              aria-hidden="true"
            >
              <ArrowRight class="size-4" />
            </li>
          )}
          <li class="min-w-0 rounded-xl border border-border p-4">
            <p class="text-sm">
              <InlineCode code={step.command} />
            </p>
            <p class="mt-2 text-xs text-muted">{step.text}</p>
          </li>
        </>
      ))
    }
  </ol>
</PreviewFrame>
