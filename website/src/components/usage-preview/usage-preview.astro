---
import Badge from 'jg-personal-astro-ui/badge';

import PreviewFrame from '../preview-frame/preview-frame.astro';
import ProviderMark from '../provider-mark/provider-mark.astro';

/*
 * Static meters, credits and session rows. HQ reads each from native accounts and storage:
 * Claude's windows keep their model scope, and Codex reports credits and earned resets
 * separately from its windows, without any redemption or purchase operation.
 */
const ACCOUNTS = [
  {
    provider: 'claude',
    name: 'Claude Code',
    windows: [
      { label: '5-hour window', scope: 'all models', usedPercent: 46, reset: 'resets 15:00' },
      { label: '7-day window', scope: 'Opus', usedPercent: 21, reset: 'resets Monday' },
    ],
    extras: [],
  },
  {
    provider: 'codex',
    name: 'Codex',
    windows: [
      { label: '5-hour window', scope: null, usedPercent: 38, reset: 'resets 14:20' },
      { label: '7-day window', scope: null, usedPercent: 12, reset: 'resets Monday' },
    ],
    extras: [
      { label: 'Credit balance', value: '120' },
      { label: 'Earned resets', value: '1 available' },
    ],
  },
] as const;
const SESSIONS = [
  { name: 'build-reports', provider: 'Codex', updated: 'Running' },
  { name: 'fix-login', provider: 'Claude Code', updated: 'Yesterday' },
  { name: 'docs-refresh', provider: 'Claude Code', updated: '3 days ago' },
] as const;
---

<PreviewFrame caption="Illustrative · usage, credits and session history">
  <div class="grid min-w-0 gap-5 sm:grid-cols-2">
    {
      ACCOUNTS.map((account) => (
        <div
          class="min-w-0"
          role="group"
          aria-label={`${account.name} usage`}
        >
          <p class="flex items-center gap-2 font-semibold">
            <ProviderMark provider={account.provider} />
            {account.name}
          </p>
          <ul class="mt-4 grid gap-4">
            {account.windows.map((quota) => (
              <li class="min-w-0">
                <p class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-sm">
                  <span class="flex flex-wrap items-center gap-2">
                    {quota.label}
                    {quota.scope && <Badge variant="outline">{quota.scope}</Badge>}
                  </span>
                  <span class="font-mono text-xs text-muted">
                    <span class="font-semibold text-foreground">{quota.usedPercent}% used</span> ·{' '}
                    {quota.reset}
                  </span>
                </p>
                {/* the text above carries the value; the bar only repeats it */}
                <div
                  class="mt-2 h-2 overflow-hidden rounded-full bg-secondary"
                  aria-hidden="true"
                >
                  <div
                    class="h-full rounded-full bg-accent"
                    style={`width: ${quota.usedPercent}%`}
                  />
                </div>
              </li>
            ))}
          </ul>
          {account.extras.length > 0 && (
            <dl class="mt-4 grid grid-cols-2 gap-2">
              {account.extras.map((extra) => (
                <div class="min-w-0 rounded-lg bg-secondary px-3 py-2">
                  <dt class="text-xs text-muted">{extra.label}</dt>
                  <dd class="font-mono text-sm font-semibold">{extra.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      ))
    }
  </div>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-border pt-5">
    <p class="font-semibold">Sessions</p>
    <Badge variant="outline">Read-only · nothing resumes</Badge>
  </div>
  <ul class="mt-3 divide-y divide-border">
    {
      SESSIONS.map((session) => (
        <li class="flex min-w-0 flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3 last:pb-0">
          <span class="min-w-0 font-mono text-sm font-semibold wrap-anywhere">{session.name}</span>
          <span class="text-xs text-muted">
            {session.provider} · {session.updated}
          </span>
        </li>
      ))
    }
  </ul>
</PreviewFrame>
