---
import {
  GitCompareArrows,
  MessagesSquare,
  ListChecks,
  Gauge,
  ShieldCheck,
  Library,
} from '@lucide/astro';
import Section from 'jg-personal-astro-ui/section';

import { HOME_CONTENT } from '../../site.config.ts';

const icons = [MessagesSquare, ListChecks, GitCompareArrows, Library, Gauge, ShieldCheck];
---

<Section
  id="capabilities"
  eyebrow="What you can build"
  title="The pieces behind a better agent workspace."
  lede="Use the same local runtime for a custom dashboard, a CLI workflow, or your team's own tools."
  border
>
  <div class="mt-8 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
    {
      HOME_CONTENT.capabilities.map((item, index) => {
        const Icon = icons[index];
        return (
          <article class="min-w-0 border-t border-border py-7 sm:py-8">
            {Icon && (
              <Icon
                class="mb-4 size-5 text-accent"
                aria-hidden="true"
              />
            )}
            <h3 class="text-lg font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-muted">{item.text}</p>
          </article>
        );
      })
    }
  </div>
</Section>
