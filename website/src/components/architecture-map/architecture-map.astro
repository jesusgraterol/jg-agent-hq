---
import IconTile from 'jg-personal-astro-ui/icon-tile';
import InlineCode from 'jg-personal-astro-ui/inline-code';
import { ArrowDown, ArrowUp, Layers, Monitor } from '@lucide/astro';

import { HOME_CONTENT } from '../../content/index.ts';

import ProviderMark from '../provider-mark/provider-mark.astro';

const map = HOME_CONTENT.map;
---

{/* the three layers top to bottom, with what flows down and back up between each pair */}
<figure
  class="min-w-0 rounded-2xl border border-border bg-surface p-5 shadow-surface sm:p-7"
  aria-labelledby="architecture-caption"
>
  <figcaption
    id="architecture-caption"
    class="font-mono text-xs text-muted"
  >
    {map.caption}
  </figcaption>
  <div
    class="mt-5 flex min-w-0 items-center gap-3 rounded-xl border border-border bg-background p-4"
  >
    <IconTile
      size="compact"
      tone="neutral"
      aria-hidden="true"
      ><Monitor /></IconTile
    >
    <p class="min-w-0">
      <span class="block font-semibold">{map.app.title}</span>
      <span class="block text-sm text-muted">{map.app.detail}</span>
    </p>
  </div>
  {
    map.links.map((link, index) => (
      <>
        <div class="grid min-w-0 grid-cols-2 gap-3 py-4">
          {[
            { direction: link.down, Icon: ArrowDown },
            { direction: link.up, Icon: ArrowUp },
          ].map(({ direction, Icon }) => (
            <div class="flex min-w-0 gap-2">
              <Icon
                class="mt-0.5 size-4 shrink-0 text-accent"
                aria-hidden="true"
              />
              <div class="min-w-0">
                <p class="font-mono text-xs text-muted">{direction.label}</p>
                {direction.items.length > 0 && (
                  <p class="mt-2 flex min-w-0 flex-wrap gap-1.5 text-xs">
                    {direction.items.map((item) => (
                      <InlineCode code={item} />
                    ))}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
        {index === 0 && (
          <div class="min-w-0 rounded-xl border border-accent/40 bg-accent/10 p-4">
            <div class="flex min-w-0 items-center gap-3">
              <IconTile
                size="compact"
                tone="accent"
                aria-hidden="true"
              >
                <Layers />
              </IconTile>
              <p class="min-w-0">
                <span class="block font-mono font-semibold text-accent">{map.hq.title}</span>
                <span class="block text-sm text-muted">{map.hq.detail}</span>
              </p>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2">
              {map.hq.parts.map((part) => (
                <li class="rounded-md border border-border bg-surface px-2.5 py-1 text-xs font-semibold">
                  {part}
                </li>
              ))}
            </ul>
          </div>
        )}
      </>
    ))
  }
  <ul class="grid min-w-0 grid-cols-2 gap-3">
    {
      map.agents.map((agent) => (
        <li class="flex min-w-0 items-center gap-3 rounded-xl border border-border bg-background p-4">
          <IconTile
            size="compact"
            tone="neutral"
            aria-hidden="true"
          >
            <ProviderMark provider={agent === 'Claude Code' ? 'claude' : 'codex'} />
          </IconTile>
          <span class="min-w-0 font-semibold">{agent}</span>
        </li>
      ))
    }
  </ul>
  <p class="mt-3 text-center text-xs text-muted">{map.agentDetail}</p>
</figure>
