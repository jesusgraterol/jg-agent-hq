{
  "name": "jg-agent-hq-website",
  "description": "The public jg-agent-hq package website and canonical documentation.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "assets:generate": "node scripts/assets/assets.ts",
    "build": "astro build && node scripts/verify-build.ts",
    "check": "pnpm test:unit && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test:integration:artifact && pnpm test:e2e:artifact",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "vitest run --config vitest/test-unit.config.ts",
    "test:integration": "pnpm build && pnpm test:integration:artifact",
    "test:integration:artifact": "vitest run --config vitest/test-integration.config.ts",
    "test:e2e": "pnpm build && pnpm test:e2e:artifact",
    "test:e2e:artifact": "playwright test",
    "typecheck": "astro check",
    "lint": "eslint astro.config.ts eslint.config.js playwright.config.ts scripts src vitest",
    "format": "prettier --write --config .prettierrc .",
    "format:check": "prettier --check --config .prettierrc .",
    "verify:public-destinations": "node scripts/public-destinations/public-destinations.ts",
    "verify:deployment": "node scripts/verify-deployment.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/ubuntu-sans": "5.3.0",
    "@fontsource-variable/ubuntu-sans-mono": "5.3.0",
    "@lucide/astro": "1.58.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.12.0",
    "astro": "7.4.0",
    "error-message-utils": "1.2.14",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "jg-personal-astro-ui": "0.3.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.12",
    "zod": "4.3.6"
  }
}
