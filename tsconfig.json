{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "vitest/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "website",
    "**/_archive/**",
    "**/_archives/**",
    "**/_backup/**",
    "**/_backups/**"
  ]
}
