{
  "name": "jg-agent-hq",
  "version": "13.1.4",
  "description": "Native Claude Code and Codex session control, history, usage and recoverable local storage for Node.js apps.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "api/README.md",
    "errors/README.md",
    "docs/recovery.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusgraterol/jg-agent-hq.git"
  },
  "scripts": {
    "build": "node scripts/package/clean.ts && tsc -p tsconfig.build.json && node scripts/package/assets.ts",
    "test": "pnpm build && pnpm test:unit --tagsFilter=!full && pnpm test:integration --tagsFilter=!full",
    "test:full": "pnpm build && pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest/test-unit.config.ts",
    "test:integration": "vitest run --config vitest/test-integration.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.contracts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "pnpm test && pnpm typecheck && pnpm format:check",
    "check:package:full": "pnpm test:full && pnpm typecheck && pnpm format:check",
    "check": "pnpm check:package && pnpm --dir website check",
    "check:full": "pnpm check:package:full && pnpm --dir website check:full"
  },
  "dependencies": {
    "jg-crypto": "^0.3.0",
    "jg-exception": "^1.7.1",
    "jg-fs": "^1.7.0",
    "jg-locks": "^1.0.0",
    "jg-utilities": "^1.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.4.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "bin": {
    "jg-agent-hq": "./dist/cli/cli.js"
  }
}
