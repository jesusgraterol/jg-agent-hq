{
  "name": "jg-agent-hq",
  "version": "8.0.1",
  "description": "Native coding-agent session control, agent streams and durable collaboration for Node.js apps.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "api/README.md",
    "errors/README.md",
    "docs/recovery.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusgraterol/jg-agent-hq.git"
  },
  "scripts": {
    "build": "node scripts/package/clean.ts && tsc -p tsconfig.build.json && node scripts/package/assets.ts",
    "test": "pnpm build && pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest/test-unit.config.ts",
    "test:integration": "vitest run --config vitest/test-integration.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.contracts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "pnpm test && pnpm typecheck && pnpm format:check",
    "check": "pnpm check:package && pnpm --dir website check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "jg-crypto": "0.3.0",
    "jg-exception": "^1.7.0",
    "jg-fs": "1.7.0",
    "jg-plans": "0.3.0",
    "jg-utilities": "1.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "prettier": "3.4.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "bin": {
    "jg-agent-hq": "./dist/cli/cli.js"
  }
}
